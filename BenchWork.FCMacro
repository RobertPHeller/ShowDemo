class RightUnit(BaseUnit):
    def __init__(self,name,origin):
        super().__init__(name,origin)
        self.left = self.MakeWireHoles(self.left)
        self.leftsheet = self.MakeWireHoles(self.leftsheet)
        self.left = self.MakeBoltHoles(self.left)
        self.leftsheet = self.MakeBoltHoles(self.leftsheet)
        self.leftsheet = self.MakeTunnelCut(self.leftsheet)
        self.leftbackdrop = self.MakeTunnelCut(self.leftbackdrop)
        self.leftcover = Sheet.YZSheet(self.origin.add(Base.Vector(
                                            -Sheet.ABThick(),
                                            -(Sheet.LexanThick()+
                                              Sheet.ABThick()),
                                            -Sheet.ABThick())),
                                       self.TotalHeight+(2*Sheet.ABThick()),
                                       self.Depth+
                                        Sheet.LexanThick()+
                                        (2*Sheet.ABThick()))
    def show(self,doc=None):
        if doc==None:
            doc = App.activeDocument()
        super().show(doc)
        obj = doc.addObject("Part::Feature",self.name+"_leftcover")
        obj.Shape = self.leftcover
        obj.Label=self.name+"_leftcover"
        obj.ViewObject.ShapeColor=Sheet.Color()
        
class CenterUnit(BaseUnit):
    def __init__(self,name,origin):
        super().__init__(name,origin)
        self.left = self.MakeWireHoles(self.left)
        self.leftsheet = self.MakeWireHoles(self.leftsheet)
        self.left = self.MakeBoltHoles(self.left)
        self.leftsheet = self.MakeBoltHoles(self.leftsheet)
        self.leftsheet = self.MakeTunnelCut(self.leftsheet)
        self.leftbackdrop = self.MakeTunnelCut(self.leftbackdrop)
        self.leftcover = Sheet.YZSheet(self.origin.add(Base.Vector(
                                            -Sheet.ABThick(),
                                            -(Sheet.LexanThick()+
                                              Sheet.ABThick()),
                                            -Sheet.ABThick())),
                                       self.TotalHeight+(2*Sheet.ABThick()),
                                       self.Depth+
                                        Sheet.LexanThick()+
                                        (2*Sheet.ABThick()))
        self.right = self.MakeWireHoles(self.right)
        self.rightsheet = self.MakeWireHoles(self.rightsheet)
        self.right = self.MakeBoltHoles(self.right)
        self.rightsheet = self.MakeBoltHoles(self.rightsheet)
        self.rightsheet = self.MakeTunnelCut(self.rightsheet)
        self.rightbackdrop = self.MakeTunnelCut(self.rightbackdrop)
        self.rightcover = Sheet.YZSheet(self.origin.add(Base.Vector(
                                            self.Length,
                                            -(Sheet.LexanThick()+
                                              Sheet.ABThick()),
                                            -Sheet.ABThick())),
                                       self.TotalHeight+(2*Sheet.ABThick()),
                                       self.Depth+
                                        Sheet.LexanThick()+
                                        (2*Sheet.ABThick()))
    def show(self,doc=None):
        if doc==None:
            doc = App.activeDocument()
        super().show(doc)
        obj = doc.addObject("Part::Feature",self.name+"_leftcover")
        obj.Shape = self.leftcover
        obj.Label=self.name+"_leftcover"
        obj.ViewObject.ShapeColor=Sheet.Color()
        obj = doc.addObject("Part::Feature",self.name+"_rightcover")
        obj.Shape = self.rightcover
        obj.Label=self.name+"_rightcover"
        obj.ViewObject.ShapeColor=Sheet.Color()
        
class LeftUnit(BaseUnit):
    def __init__(self,name,origin):
        super().__init__(name,origin)
        self.right = self.MakeWireHoles(self.right)
        self.rightsheet = self.MakeWireHoles(self.rightsheet)
        self.right = self.MakeBoltHoles(self.right)
        self.rightsheet = self.MakeBoltHoles(self.rightsheet)
        self.rightsheet = self.MakeTunnelCut(self.rightsheet)
        self.rightbackdrop = self.MakeTunnelCut(self.rightbackdrop)
        self.rightcover = Sheet.YZSheet(self.origin.add(Base.Vector(
                                            self.Length,
                                            -(Sheet.LexanThick()+
                                              Sheet.ABThick()),
                                            -Sheet.ABThick())),
                                       self.TotalHeight+(2*Sheet.ABThick()),
                                       self.Depth+
                                        Sheet.LexanThick()+
                                        (2*Sheet.ABThick()))
    def show(self,doc=None):
        if doc==None:
            doc = App.activeDocument()
        super().show(doc)
        obj = doc.addObject("Part::Feature",self.name+"_rightcover")
        obj.Shape = self.rightcover
        obj.Label=self.name+"_rightcover"
        obj.ViewObject.ShapeColor=Sheet.Color()
        
if __name__ == '__main__':
    if "BenchWork" in App.listDocuments().keys():
        App.closeDocument("BenchWork")
    doc = App.newDocument("BenchWork")
    doc = App.activeDocument()
    station1 = RightUnit("RightUnit",Base.Vector(Units.mm(Units.inches(8)),0,0))
    station1.show(doc)
    center = CenterUnit("CenterUnit",Base.Vector(Units.mm(Units.inches(4)),0,0))
    center.show(doc)
    station2 = LeftUnit("LeftUnit",Base.Vector(0,0,0))
    station2.show(doc)
    Gui.activeDocument().activeView().viewTop()
    Gui.SendMsgToActiveView("ViewFit")
    BOMHelper.ListCuts("BOM.csv")
    #
    for g in doc.findObjects('TechDraw::DrawSVGTemplate'):
        doc.removeObject(g.Name)
    for g in doc.findObjects('TechDraw::DrawPage'):
        doc.removeObject(g.Name)
    for g in doc.findObjects('Spreadsheet::Sheet'):
        doc.removeObject(g.Name)
    for g in doc.findObjects('TechDraw::DrawViewPart'):
        doc.removeObject(g.Name)
    for g in doc.findObjects('TechDraw::DrawViewDimension'):
        doc.removeObject(g.Name)
    template = doc.addObject('TechDraw::DrawSVGTemplate','USLetterTemplate')
    template.Template = App.getResourceDir()+"Mod/TechDraw/Templates/USLetter_Landscape.svg"
    edt = template.EditableTexts
    edt['CompanyName'] = "Deepwoods Software"
    edt['CompanyAddress'] = '51 Locke Hill Road, Wendell, MA 01379 USA'   
    edt['DrawingTitle1']= 'Show Demo (Two station push-pull)'
    edt['DrawingTitle3']= ""
    edt['DrawnBy'] = "Robert Heller"
    edt['CheckedBy'] = ""
    edt['Approved1'] = ""
    edt['Approved2'] = ""
    edt['Code'] = ""
    edt['Weight'] = ''
    edt['DrawingNumber'] = datetime.datetime.now().ctime()
    edt['Revision'] = "A"
    template.EditableTexts = edt
    #*****
    # General wire holes (Inner supports)
    #
    page = doc.addObject('TechDraw::DrawPage','WireHolesDrillSheetPage')
    page.Template = template
    edt = page.Template.EditableTexts
    edt['DrawingTitle2']= "Wire Holes"
    edt['scale'] = 'Scale: .5'
    edt['Sheet'] = "Sheet 1 of 3"
    page.Template.EditableTexts = edt
    page.ViewObject.show()
    view = doc.addObject('TechDraw::DrawViewPart','WireHolesDrill')
    page.addView(view)
    view.Source = doc.getObject("RightUnit_left1")
    view.Direction=(1.0,0,0)
    view.ScaleType='Custom'
    view.Scale = 1/2
    view.X = 140
    view.Y = 120
    #
    # Vertex1 origin
    # Vertex12 h1 center
    # Vertex9  h2 center
    # Vertex6  h3 center
    # Edge6    h1 circumfrence
    #
    dim1 = doc.addObject('TechDraw::DrawViewDimension','H1X')
    dim1.Type = 'DistanceX'
    dim1.References2D = [ (view, 'Vertex1'), (view, 'Vertex12') ]
    dim1.FormatSpec='3in'
    dim1.Arbitrary = True
    dim1.X = -53
    dim1.Y = -8
    page.addView(dim1)
    dim2 = doc.addObject('TechDraw::DrawViewDimension','H2X')
    dim2.Type = 'DistanceX'
    dim2.References2D = [ (view, 'Vertex1'), (view, 'Vertex9') ]
    dim2.FormatSpec='6in'
    dim2.Arbitrary = True
    dim2.X = -15
    dim2.Y = -15
    page.addView(dim2)
    dim3 = doc.addObject('TechDraw::DrawViewDimension','H3X')
    dim3.Type = 'DistanceX'
    dim3.References2D = [ (view, 'Vertex1'), (view, 'Vertex6') ]
    dim3.FormatSpec='9in'
    dim3.Arbitrary = True
    dim3.X = 25
    dim3.Y = -20
    page.addView(dim3)
    dim4 = doc.addObject('TechDraw::DrawViewDimension','V1Y')
    dim4.Type = 'DistanceY'
    dim4.References2D = [ (view, 'Vertex1'), (view, 'Vertex6') ]
    dim4.FormatSpec="%.3fin"%(5.5/2)
    dim4.Arbitrary = True
    dim4.X = -72
    dim4.Y =  15
    page.addView(dim4)
    dim5 = doc.addObject('TechDraw::DrawViewDimension','D1')
    dim5.Type = 'Diameter'
    dim5.References2D = [ (view, 'Edge6') ]
    dim5.FormatSpec="2in (3x)"
    dim5.Arbitrary = True
    dim5.X = -14
    dim5.Y =  23
    page.addView(dim5)
    
    doc.recompute()
    sleep(500)
