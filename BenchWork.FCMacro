import FreeCAD as App
import Part, TechDraw, Mesh
from FreeCAD import Base

import os
import sys
sys.path.append(os.path.dirname(__file__))
import csv
import math
import Units
from debug import debug

import csv

def NormalizeMM(x):
    return round(x,3)

class PineBoard(object):
    _BOM = dict()
    @classmethod
    def AddPiece(cls,width,height):
        key = (NormalizeMM(width),NormalizeMM(height))
        if key in cls._BOM:
            cls._BOM[key] += 1
        else:
            cls._BOM[key] = 1
    @staticmethod
    def _normPartSizeMM(t):
        return ("%.3fx%.3f of Pine board (3/4)" % t)
    @staticmethod
    def _inch(mm):
        return mm / 25.4
    @staticmethod
    def _normPartSizeIN(t):
        X, Y = t
        return ("%.4fx%.4f of Pine board (3/4)" % (PineBoard._inch(X), PineBoard._inch(Y)))
    _units = 'in'
    @classmethod
    def SetUnits(cls,units):
        if units == 'in' or units == 'mm':
            cls._units = units
        else:
            raise RuntimeError("Unsupport units!")
    @classmethod
    def GetUnits(cls):
        return cls._units
    @classmethod
    def _normPartSize(cls,t):
        if cls._units == 'in':
            return PineBoard._normPartSizeIN(t)
        elif cls._units == 'mm':
            return PineBoard._normPartSizeMM(t)
        else:
            raise RuntimeError("Unsupport units!")
    @classmethod
    def ListCuts(cls,filename):
        keys = list(cls._BOM.keys())
        keys.sort()
        f = open(filename,"w")
        w = csv.writer(f)
        w.writerow([("Size (%s)" % cls._units),"Count"])
        for key in keys:
            w.writerow([cls._normPartSize(key),cls._BOM[key]])
        f.close()
    __thick = Units.mm(3/4)
    def __init__(self):
        raise RuntimeError("No Instances allowed for PineBoard!")
    @classmethod
    def BoardThickness(cls):
        return cls.__thick
    __Color = (0xBA/255.0, 0x70/255.0, 0x0F/255.0)
    @classmethod
    def Color(cls):
        return cls.__Color
    @classmethod
    def ZXBoard(cls,origin,width,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        board = Part.makePlane(width,length,origin,Base.Vector(0,1,0)).extrude(Base.Vector(0,cls.__thick,0))
        bb = board.BoundBox
        PineBoard.AddPiece(bb.XLength,bb.ZLength)
        return board
    @classmethod
    def YXBoard(cls,origin,width,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        board = Part.makePlane(width,length,origin,Base.Vector(0,0,1)).extrude(Base.Vector(0,0,cls.__thick))
        bb = board.BoundBox
        PineBoard.AddPiece(bb.YLength,bb.XLength)
        return board
    @classmethod
    def ZYBoard(cls,origin,width,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        board = Part.makePlane(width,length,origin.add(Base.Vector(0,length,0)),
                               Base.Vector(1,0,0)) \
                  .extrude(Base.Vector(cls.__thick,0,0))
        bb = board.BoundBox
        PineBoard.AddPiece(bb.YLength,bb.ZLength)
        return board
    @classmethod
    def XYBoard(cls,origin,width,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        board = Part.makePlane(width,length,origin,Base.Vector(0,0,1)).extrude(Base.Vector(0,0,cls.__thick))
        bb = board.BoundBox
        PineBoard.AddPiece(bb.YLength,bb.XLength)
        return board
    @classmethod
    def ZBeam(cls,origin,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        beam = Part.makePlane(cls.__thick,cls.__thick,origin,Base.Vector(0,0,1)).extrude(Base.Vector(0,0,length))
        bb = beam.BoundBox
        PineBoard.AddPiece(bb.YLength,bb.ZLength)
        return beam
    @classmethod
    def XBeam(cls,origin,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        beam = Part.makePlane(cls.__thick,cls.__thick,origin,Base.Vector(1,0,0)).extrude(Base.Vector(length,0,0))
        bb = beam.BoundBox
        PineBoard.AddPiece(bb.YLength,bb.ZLength)
        return beam
    @classmethod
    def YBeam(cls,origin,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        beam = Part.makePlane(cls.__thick,cls.__thick,origin,Base.Vector(0,1,0)).extrude(Base.Vector(0,length,0))
        bb = beam.BoundBox
        PineBoard.AddPiece(bb.XLength,bb.ZLength)
        return beam
         

class Plywood(object):
    __BOM = dict()
    @classmethod
    def AddPiece(cls,width,length,kind):
        key = (NormalizeMM(width),NormalizeMM(length),kind)
        if key in cls.__BOM:
            cls.__BOM[key] += 1
        else:
            cls.__BOM[key] = 1
    @staticmethod
    def _normPartSizeMM(t):
        return ("%.3fx%.3f of %s" % t)
    @staticmethod      
    def _inch(mm):  
        return mm / 25.4  
    @staticmethod
    def _normPartSizeIN(t):
        X, Y, kind = t 
        return ("%.4fx%.4f of %s" % (Plywood._inch(X), Plywood._inch(Y), kind)) 
    _units = 'in' 
    @classmethod     
    def SetUnits(cls,units):   
        if units == 'in' or units == 'mm':
            cls._units = units         
        else: 
            raise RuntimeError("Unsupport units!")      
    @classmethod       
    def GetUnits(cls): 
        return cls._units  
    @classmethod   
    def _normPartSize(cls,t): 
        if cls._units == 'in':
            return Plywood._normPartSizeIN(t)
        elif cls._units == 'mm':
            return Plywood._normPartSizeMM(t)
        else:
            raise RuntimeError("Unsupport units!")
    @classmethod  
    def ListCuts(cls,filename): 
        keys = list(cls.__BOM.keys())
        keys.sort()   
        f = open(filename,"w") 
        w = csv.writer(f)  
        w.writerow([("Size (%s)" % cls._units),"Count"]) 
        for key in keys:  
            w.writerow([cls._normPartSize(key),cls.__BOM[key]])
        f.close()        
    def __init__(self):
        raise RuntimeError("No Instances allowed for Plywood")
    __AB3_8Thick = Units.mm(3/8)
    @classmethod
    def ABThick(cls):
        return cls.__AB3_8Thick
    __Birch1_4Thick = Units.mm(1/4)
    @classmethod
    def BirchThick(cls):
        return cls.__Birch1_4Thick
    __Masonite1_8hick = Units.mm(1/8)
    @classmethod
    def MasoniteThick(cls):
        return cls.__Masonite1_8hick
    __Color = (1.0,1.0,0.0)
    __BirchColor = (1.0,1.0,1.0)
    __MasoniteColor = (139.0/255.0,  35.0/255.0,  35.0/255.0) 
    @classmethod
    def Color(cls):
        return cls.__Color
    @classmethod
    def BirchColor(cls):
        return cls.__BirchColor
    @classmethod
    def MasoniteColor(cls):
        return cls.__MasoniteColor
    @classmethod
    def XYSheet(cls,origin,width,length,plytype="AB"):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        thick = None
        kind = None
        if plytype == "AB":
            thick = cls.__AB3_8Thick
            kind = "3/8 AB"
        elif plytype == "Birch":
            thick = cls.__Birch1_4Thick
            kind = "1/4 Birch"
        elif plytype == "Masonite":
            thick = cls.__Masonite1_8hick
            kind = "1/8 Masonite"
        else:
            raise RuntimeError("Unsupport plywood type")
        sheet = Part.makePlane(width,length,origin,Base.Vector(0,0,1)).extrude(Base.Vector(0,0,thick))
        bb = sheet.BoundBox
        Plywood.AddPiece(bb.XLength,bb.YLength,kind)
        return sheet
    @classmethod
    def XZSheet(cls,origin,width,length,plytype="AB"):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        thick = None
        kind = None
        if plytype == "AB":
            thick = cls.__AB3_8Thick
            kind = "3/8 AB"
        elif plytype == "Birch":
            thick = cls.__Birch1_4Thick
            kind = "1/4 Birch"
        elif plytype == "Masonite":
            thick = cls.__Masonite1_8hick
            kind = "1/8 Masonite"
        else:
            raise RuntimeError("Unsupport plywood type")
        sheet = Part.makePlane(width,length,origin,Base.Vector(0,1,0)).extrude(Base.Vector(0,thick,0))
        bb = sheet.BoundBox
        Plywood.AddPiece(bb.XLength,bb.ZLength,kind)
        return sheet
    @classmethod
    def YZSheet(cls,origin,width,length,plytype="AB"):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        thick = None
        kind = None
        if plytype == "AB":
            thick = cls.__AB3_8Thick
            kind = "3/8 AB"
        elif plytype == "Birch":
            thick = cls.__Birch1_4Thick
            kind = "1/4 Birch"
        elif plytype == "Masonite":
            thick = cls.__Masonite1_8hick
            kind = "1/8 Masonite"
        else:
            raise RuntimeError("Unsupport plywood type")
        sheet = Part.makePlane(width,length,origin.add(Base.Vector(0,length,0)),Base.Vector(1,0,0)).extrude(Base.Vector(thick,0,0))
        bb = sheet.BoundBox
        Plywood.AddPiece(bb.ZLength,bb.YLength,kind)
        return sheet
    
class BaseUnit(object):
    __Length = Units.mm(Units.inches(3))
    __Depth  = Units.mm(12)
    __TotalHeight = Units.mm(12)
    __BaseSupportHeight = Units.mm(5.5)
    __BaseSupportOffsets = [ Units.mm(3/8), Units.mm(11.5), Units.mm(23.5), Units.mm((Units.inches(3)-(3/8))-(3/4)) ]
    def __init__(self,name,origin):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        self.origin = origin
        self.name = name
        self.left = PineBoard.ZYBoard(
            self.origin.add(Base.Vector(self.__BaseSupportOffsets[0],0,0)),
            self.__BaseSupportHeight,
            self.__Depth)
        self.left1 = PineBoard.ZYBoard(
            self.origin.add(Base.Vector(self.__BaseSupportOffsets[1],0,0)),
            self.__BaseSupportHeight,
            self.__Depth-PineBoard.BoardThickness())
        self.right1 = PineBoard.ZYBoard(
            self.origin.add(Base.Vector(self.__BaseSupportOffsets[2],0,0)),
            self.__BaseSupportHeight,
            self.__Depth-PineBoard.BoardThickness())
        self.right = PineBoard.ZYBoard(
            self.origin.add(Base.Vector(self.__BaseSupportOffsets[3],0,0)),
            self.__BaseSupportHeight,
            self.__Depth)
        #debug("BaseUnit(): self.__BaseSupportOffsets[3] is %f",self.__BaseSupportOffsets[3])
        backlen = self.__BaseSupportOffsets[3]-self.__BaseSupportOffsets[0]
        backlen -= PineBoard.BoardThickness()
        #debug("BaseUnit(): backlen is %f",backlen)
        self.back = PineBoard.ZXBoard(
            self.origin.add(Base.Vector(PineBoard.BoardThickness()+self.__BaseSupportOffsets[0],
                                        self.__Depth-PineBoard.BoardThickness(),
                                        0)),
            self.__BaseSupportHeight,
            backlen)
        self.leftsheet = Plywood.YZSheet(self.origin,self.__Depth,self.__TotalHeight)
        self.rightsheet = Plywood.YZSheet(self.origin.add(Base.Vector(self.__Length-Plywood.ABThick(),0,0)),
                                          self.__Depth,self.__TotalHeight)
        self.backsheet = Plywood.XZSheet(self.origin.add(Base.Vector(0,self.__Depth,0)),
                                         self.__TotalHeight,self.__Length)
        self.layoutsheet = Plywood.XYSheet(self.origin.add(Base.Vector(Units.mm(3/8),
                                                                       0,
                                                                       self.__BaseSupportHeight)),
                                           self.__Length-(2*Plywood.ABThick()),
                                           self.__Depth,
                                           "Birch")
        self.bottom = Plywood.XYSheet(self.origin.add(Base.Vector(0,0,
                                                                  -Plywood.ABThick())),
                                      self.__Length,
                                      self.__Depth+Plywood.ABThick())
        self.top = Plywood.XYSheet(self.origin.add(Base.Vector(0,
                                                               Units.mm(2),
                                                               self.__TotalHeight)),
                                   self.__Length,
                                   self.__Depth-Units.mm(2)+Plywood.ABThick())
        self.leftbackdrop = Plywood.YZSheet(self.origin.add(Base.Vector(Plywood.ABThick(),
                                                                        0,
                                                                        self.__BaseSupportHeight+Plywood.BirchThick())),
                                            self.__TotalHeight-(self.__BaseSupportHeight+Plywood.BirchThick()),
                                            self.__Depth,
                                            "Masonite")
        self.rightbackdrop = Plywood.YZSheet(self.origin.add(Base.Vector(self.__Length-Plywood.ABThick()-Plywood.MasoniteThick(),
                                                                        0,
                                                                        self.__BaseSupportHeight+Plywood.BirchThick())),
                                            self.__TotalHeight-(self.__BaseSupportHeight+Plywood.BirchThick()),
                                            self.__Depth,
                                            "Masonite")
        self.backbackdrop = Plywood.XZSheet(self.origin.add(Base.Vector(Plywood.ABThick()+Plywood.MasoniteThick(),
                                                                        self.__Depth-Plywood.MasoniteThick(),
                                                                        self.__BaseSupportHeight+Plywood.BirchThick())),
                                            self.__TotalHeight-self.__BaseSupportHeight-Plywood.BirchThick(),
                                            self.__Length-(2*(Plywood.ABThick()+Plywood.MasoniteThick())),
                                            "Masonite")
        self.p1 = PineBoard.ZBeam(
                        self.origin.add(
                            Base.Vector(
                                Plywood.ABThick()+Plywood.MasoniteThick(),
                                0,
                                self.__BaseSupportHeight+Plywood.BirchThick())),
                        self.__TotalHeight-self.__BaseSupportHeight-Plywood.BirchThick())
        self.p2 = PineBoard.ZBeam(
                        self.origin.add(
                            Base.Vector(
                                Plywood.ABThick()+Plywood.MasoniteThick(),
                                self.__Depth-PineBoard.BoardThickness()-Plywood.MasoniteThick(),
                                self.__BaseSupportHeight+Plywood.BirchThick())),
                        self.__TotalHeight-self.__BaseSupportHeight-Plywood.BirchThick())
        self.p3 = PineBoard.ZBeam(
                        self.origin.add(
                            Base.Vector(
                                self.__Length-(Plywood.ABThick()+
                                               Plywood.MasoniteThick()+
                                               PineBoard.BoardThickness()),
                                0,
                                self.__BaseSupportHeight+Plywood.BirchThick())),
                        self.__TotalHeight-self.__BaseSupportHeight-Plywood.BirchThick())
        self.p4 = PineBoard.ZBeam(
                        self.origin.add(
                            Base.Vector(
                                self.__Length-(Plywood.ABThick()+
                                               Plywood.MasoniteThick()+
                                               PineBoard.BoardThickness()),
                                self.__Depth-PineBoard.BoardThickness()-Plywood.MasoniteThick(),
                                self.__BaseSupportHeight+Plywood.BirchThick())),
                        self.__TotalHeight-self.__BaseSupportHeight-Plywood.BirchThick())
        self.l1 = PineBoard.YBeam(
                    self.origin.add(
                        Base.Vector(Plywood.ABThick()+Plywood.MasoniteThick(),
                                    PineBoard.BoardThickness(),
                                    self.__TotalHeight-PineBoard.BoardThickness())),
                    self.__Depth-(2*PineBoard.BoardThickness())-Plywood.MasoniteThick())
        self.l2 = PineBoard.YBeam(
                    self.origin.add(
                        Base.Vector(self.__Length-(Plywood.ABThick()+
                                               Plywood.MasoniteThick()+
                                               PineBoard.BoardThickness()),
                                    PineBoard.BoardThickness(),
                                    self.__TotalHeight-PineBoard.BoardThickness())),
                    self.__Depth-(2*PineBoard.BoardThickness())-Plywood.MasoniteThick())
        self.l3 = PineBoard.XBeam(
                    self.origin.add(
                        Base.Vector(Plywood.ABThick()+Plywood.MasoniteThick()+
                                    PineBoard.BoardThickness(),
                                    self.__Depth-Plywood.MasoniteThick(),
                                    self.__TotalHeight-PineBoard.BoardThickness())),
                     self.__Length-(2*(Plywood.ABThick()+
                                       Plywood.MasoniteThick()+
                                       PineBoard.BoardThickness())))
    def show(self,doc=None):
        if doc==None:
            doc = App.activeDocument()
        obj = doc.addObject("Part::Feature",self.name+"_left")
        obj.Shape = self.left
        obj.Label=self.name+"_left"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_left1")
        obj.Shape = self.left1
        obj.Label=self.name+"_left1"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_right1")
        obj.Shape = self.right1
        obj.Label=self.name+"_right1"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_right")
        obj.Shape = self.right
        obj.Label=self.name+"_right"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_back")
        obj.Shape = self.back
        obj.Label=self.name+"_back"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_leftsheet")
        obj.Shape = self.leftsheet
        obj.Label=self.name+"_leftsheet"
        obj.ViewObject.ShapeColor=Plywood.Color()
        obj = doc.addObject("Part::Feature",self.name+"_rightsheet")
        obj.Shape = self.rightsheet
        obj.Label=self.name+"_rightsheet"
        obj.ViewObject.ShapeColor=Plywood.Color()
        obj = doc.addObject("Part::Feature",self.name+"_backsheet")
        obj.Shape = self.backsheet
        obj.Label=self.name+"_backsheet"
        obj.ViewObject.ShapeColor=Plywood.Color()
        obj = doc.addObject("Part::Feature",self.name+"_layoutsheet")
        obj.Shape = self.layoutsheet
        obj.Label=self.name+"_layoutsheet"
        obj.ViewObject.ShapeColor=Plywood.BirchColor()
        obj = doc.addObject("Part::Feature",self.name+"_bottom")
        obj.Shape = self.bottom
        obj.Label=self.name+"_bottom"
        obj.ViewObject.ShapeColor=Plywood.Color()
        obj = doc.addObject("Part::Feature",self.name+"_top")
        obj.Shape = self.top
        obj.Label=self.name+"_top"
        obj.ViewObject.ShapeColor=Plywood.Color()
        obj = doc.addObject("Part::Feature",self.name+"_leftbackdrop")
        obj.Shape = self.leftbackdrop
        obj.Label=self.name+"_leftbackdrop"
        obj.ViewObject.ShapeColor=Plywood.MasoniteColor()
        obj = doc.addObject("Part::Feature",self.name+"_rightbackdrop")
        obj.Shape = self.rightbackdrop
        obj.Label=self.name+"_rightbackdrop"
        obj.ViewObject.ShapeColor=Plywood.MasoniteColor()
        obj = doc.addObject("Part::Feature",self.name+"_backbackdrop")
        obj.Shape = self.backbackdrop
        obj.Label=self.name+"_backbackdrop"
        obj.ViewObject.ShapeColor=Plywood.MasoniteColor()
        obj = doc.addObject("Part::Feature",self.name+"_p1")
        obj.Shape = self.p1
        obj.Label=self.name+"_p1"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_p2")
        obj.Shape = self.p2
        obj.Label=self.name+"_p2"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_p3")
        obj.Shape = self.p3
        obj.Label=self.name+"_p3"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_p4")
        obj.Shape = self.p4
        obj.Label=self.name+"_p4"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_l1")
        obj.Shape = self.l1
        obj.Label=self.name+"_l1"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_l2")
        obj.Shape = self.l2
        obj.Label=self.name+"_l2"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_l3")
        obj.Shape = self.l3
        obj.Label=self.name+"_l3"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        

if __name__ == '__main__':
    if "BenchWork" in App.listDocuments().keys():
        App.closeDocument("BenchWork")
    doc = App.newDocument("BenchWork")
    doc = App.activeDocument()
    station = BaseUnit("BaseUnit",Base.Vector(0,0,0))
    station.show(doc)
    Gui.activeDocument().activeView().viewTop()
    Gui.SendMsgToActiveView("ViewFit")
    PineBoard.ListCuts("Pine.csv")
    Plywood.ListCuts("Plywood.csv")
