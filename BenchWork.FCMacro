import time
from PySide.QtCore import QCoreApplication, QEventLoop, QTimer

def execute(loop, ms):
    timer = QTimer()
    timer.setSingleShot(True)
    
    timer.timeout.connect(loop.quit)
    timer.start(ms)
    loop.exec_()

def sleep(ms):
    if not QCoreApplication.instance():
        app = QCoreApplication([])
        execute(app, ms)
    else:
        loop = QEventLoop()
        execute(loop, ms)
                                        



import csv

def NormalizeMM(x):
    return round(x,3)

class BOMHelper(object):
    __BOM = dict()
    @classmethod
    def AddPiece(cls,width,height,kind):
        key = (NormalizeMM(width),NormalizeMM(height),kind)
        if key in cls.__BOM:
            cls.__BOM[key] += 1
        else:
            cls.__BOM[key] = 1
    @classmethod
    def _normPartSizeMM(cls,t):
        return ("%.3fx%.3f" % t)
    @staticmethod
    def _inch(mm):
        return mm / 25.4
    @classmethod
    def _normPartSizeIN(cls,t):
        X, Y = t
        return ("%.4fx%.4f" % (cls._inch(X), cls._inch(Y)))
    _units = 'in'
    @classmethod
    def SetUnits(cls,units):
        if units == 'in' or units == 'mm':
            cls._units = units
        else:
            raise RuntimeError("Unsupport units!")
    @classmethod
    def GetUnits(cls):
        return cls._units
    @classmethod
    def _normPartSize(cls,t):
        if cls._units == 'in':
            return cls._normPartSizeIN(t)
        elif cls._units == 'mm':
            return BOMHelper._normPartSizeMM(t)
        else:
            raise RuntimeError("Unsupport units!")
    @classmethod
    def ListCuts(cls,filename):
        keys = list(cls.__BOM.keys())
        keys.sort()
        f = open(filename,"w")
        w = csv.writer(f)
        w.writerow([("Size (%s)" % cls._units),"Count"])
        for key in keys:
            X, Y, kind = key
            w.writerow([cls._normPartSize((X,Y)),kind,cls.__BOM[key]])
        f.close()
    

class PineBoard(BOMHelper):
    __thick = Units.mm(3/4)
    def __init__(self):
        raise RuntimeError("No Instances allowed for PineBoard!")
    @classmethod
    def BoardThickness(cls):
        return cls.__thick
    __Color = (0xBA/255.0, 0x70/255.0, 0x0F/255.0)
    @classmethod
    def Color(cls):
        return cls.__Color
    @classmethod
    def ZXBoard(cls,origin,width,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        board = Part.makePlane(width,length,origin,Base.Vector(0,1,0)).extrude(Base.Vector(0,cls.__thick,0))
        bb = board.BoundBox
        cls.AddPiece(bb.ZLength,bb.XLength,"Pine board (3/4in)")
        return board
    @classmethod
    def YXBoard(cls,origin,width,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        board = Part.makePlane(width,length,origin,Base.Vector(0,0,1)).extrude(Base.Vector(0,0,cls.__thick))
        bb = board.BoundBox
        cls.AddPiece(bb.YLength,bb.XLength,"Pine board (3/4in)")
        return board
    @classmethod
    def ZYBoard(cls,origin,width,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        board = Part.makePlane(width,length,origin.add(Base.Vector(0,length,0)),
                               Base.Vector(1,0,0)) \
                  .extrude(Base.Vector(cls.__thick,0,0))
        bb = board.BoundBox
        cls.AddPiece(bb.ZLength,bb.YLength,"Pine board (3/4in)")
        return board
    @classmethod
    def XYBoard(cls,origin,width,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        board = Part.makePlane(width,length,origin,Base.Vector(0,0,1)).extrude(Base.Vector(0,0,cls.__thick))
        bb = board.BoundBox
        cls.AddPiece(bb.YLength,bb.XLength,"Pine board (3/4in)")
        return board
    @classmethod
    def ZBeam(cls,origin,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        beam = Part.makePlane(cls.__thick,cls.__thick,origin,Base.Vector(0,0,1)).extrude(Base.Vector(0,0,length))
        bb = beam.BoundBox
        cls.AddPiece(bb.YLength,bb.ZLength,"Pine board (3/4in)")
        return beam
    @classmethod
    def XBeam(cls,origin,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        beam = Part.makePlane(cls.__thick,cls.__thick,origin,Base.Vector(1,0,0)).extrude(Base.Vector(length,0,0))
        bb = beam.BoundBox
        cls.AddPiece(bb.YLength,bb.XLength,"Pine board (3/4in)")
        return beam
    @classmethod
    def YBeam(cls,origin,length):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        beam = Part.makePlane(cls.__thick,cls.__thick,origin,Base.Vector(0,1,0)).extrude(Base.Vector(0,length,0))
        bb = beam.BoundBox
        cls.AddPiece(bb.XLength,bb.YLength,"Pine board (3/4in)")
        return beam
         

class Sheet(BOMHelper):
    def __init__(self):
        raise RuntimeError("No Instances allowed for Sheet")
    __AB3_8Thick = Units.mm(3/8)
    @classmethod
    def ABThick(cls):
        return cls.__AB3_8Thick
    __Birch1_4Thick = Units.mm(1/4)
    @classmethod
    def BirchThick(cls):
        return cls.__Birch1_4Thick
    __Masonite1_8Thick = Units.mm(1/8)
    @classmethod
    def MasoniteThick(cls):
        return cls.__Masonite1_8Thick
    __Lexan1_8Thick = Units.mm(1/8)
    @classmethod
    def LexanThick(cls):
        return cls.__Lexan1_8Thick
    __Color = (1.0,1.0,0.0)
    __BirchColor = (1.0,1.0,1.0)
    __MasoniteColor = (139.0/255.0,  35.0/255.0,  35.0/255.0) 
    @classmethod
    def Color(cls):
        return cls.__Color
    @classmethod
    def BirchColor(cls):
        return cls.__BirchColor
    @classmethod
    def MasoniteColor(cls):
        return cls.__MasoniteColor
    @classmethod
    def XYSheet(cls,origin,width,length,sheettype="AB"):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        thick = None
        kind = None
        if sheettype == "AB":
            thick = cls.__AB3_8Thick
            kind = "3/8 AB Plywood"
        elif sheettype == "Birch":
            thick = cls.__Birch1_4Thick
            kind = "1/4 Birch Plywood"
        elif sheettype == "Masonite":
            thick = cls.__Masonite1_8Thick
            kind = "1/8 Masonite"
        elif sheettype == "Lexan":
            thick = cls.__Lexan1_8Thick
            kind = "1/8 Lexan"
        else:
            raise RuntimeError("Unsupport plywood type")
        sheet = Part.makePlane(width,length,origin,Base.Vector(0,0,1)).extrude(Base.Vector(0,0,thick))
        bb = sheet.BoundBox
        cls.AddPiece(bb.XLength,bb.YLength,kind)
        return sheet
    @classmethod
    def XZSheet(cls,origin,width,length,sheettype="AB"):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        thick = None
        kind = None
        if sheettype == "AB":
            thick = cls.__AB3_8Thick
            kind = "3/8 AB Plywood"
        elif sheettype == "Birch":
            thick = cls.__Birch1_4Thick
            kind = "1/4 Birch Plywood"
        elif sheettype == "Masonite":
            thick = cls.__Masonite1_8Thick
            kind = "1/8 Masonite"
        elif sheettype == "Lexan":
            thick = cls.__Lexan1_8Thick
            kind = "1/8 Lexan"
        else:
            raise RuntimeError("Unsupport plywood type")
        sheet = Part.makePlane(width,length,origin,Base.Vector(0,1,0)).extrude(Base.Vector(0,thick,0))
        bb = sheet.BoundBox
        cls.AddPiece(bb.XLength,bb.ZLength,kind)
        return sheet
    @classmethod
    def YZSheet(cls,origin,width,length,sheettype="AB"):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        thick = None
        kind = None
        if sheettype == "AB":
            thick = cls.__AB3_8Thick
            kind = "3/8 AB Plywood"
        elif sheettype == "Birch":
            thick = cls.__Birch1_4Thick
            kind = "1/4 Birch Plywood"
        elif sheettype == "Masonite":
            thick = cls.__Masonite1_8Thick
            kind = "1/8 Masonite"
        elif sheettype == "Lexan":
            thick = cls.__Lexan1_8Thick
            kind = "1/8 Lexan"
        else:
            raise RuntimeError("Unsupport plywood type")
        sheet = Part.makePlane(width,length,origin.add(Base.Vector(0,length,0)),Base.Vector(1,0,0)).extrude(Base.Vector(thick,0,0))
        bb = sheet.BoundBox
        cls.AddPiece(bb.ZLength,bb.YLength,kind)
        return sheet
    

class BaseUnit(object):
    __Length = Units.mm(Units.inches(3))
    __Depth  = Units.mm(12)
    __TotalHeight = Units.mm(12)
    @property
    def Length(self):
        return self.__Length
    @property
    def Depth(self):
        return self.__Depth;
    @property
    def TotalHeight(self):
        return self.__TotalHeight
    __BaseSupportHeight = Units.mm(5.5)
    __BaseSupportOffsets = [ Units.mm(3/8), Units.mm(11.5), Units.mm(23.5), Units.mm((Units.inches(3)-(3/8))-(3/4)) ]
    __WireHoleYCenters = [ Units.mm(3), Units.mm(6), Units.mm(9) ]
    __WireHoleZCenter  = Units.mm(5.5) / 2.0
    __WireHoleDiameter = Units.mm(2)
    __BoltHoleYCenters = [ Units.mm(1.5), Units.mm(10.5) ]
    __BoltHoleZCenters = [ Units.mm(1.5), Units.mm(4) ]
    __BoltHoleDiameter = Units.mm(1/4)
    __TunnelY1         = Units.mm(2.25)
    __TunnelY2         = Units.mm(5.75)
    __TunnelZ0         = Units.mm(5.5)+Sheet.BirchThick()
    __TunnelZTop       = Units.mm(5.5)+Sheet.BirchThick()+Units.mm(3)
    __TunnelTopRadius  = Units.mm(1/2)
    @classmethod
    def TunnelCutPattern(cls):
        panelorig = Base.Vector(0,0,0)
        panel = Sheet.YZSheet(panelorig,cls.__Depth,cls.__TotalHeight)
        bb = panel.BoundBox
        X = bb.XMin 
        XDepth = bb.XLength
        owidth = cls.__TunnelY2-cls.__TunnelY1
        oheight = cls.__TunnelZTop-cls.__TunnelZ0
        openorig = Base.Vector(X,cls.__TunnelY1+owidth,cls.__TunnelZ0)
        r1orig = openorig.add(Base.Vector(0,cls.__TunnelTopRadius,oheight-cls.__TunnelTopRadius))
        temp = Part.makePlane(cls.__TunnelTopRadius*2,
                              cls.__TunnelTopRadius*2,
                              r1orig,Base.Vector(1,0,0)).extrude(Base.Vector(XDepth,0,0))
        r1 = Part.makeCylinder(cls.__TunnelTopRadius,XDepth,
                               r1orig.add(Base.Vector(0,-cls.__TunnelTopRadius*2,0)),
                               Base.Vector(1,0,0))
        opening = opening.cut(temp.cut(r1))
        r2orig = openorig.add(Base.Vector(0,-owidth+cls.__TunnelTopRadius,
                                          oheight-cls.__TunnelTopRadius))
        temp = Part.makePlane(cls.__TunnelTopRadius*2,
                              cls.__TunnelTopRadius*2,
                              r2orig,Base.Vector(1,0,0)).extrude(Base.Vector(XDepth))
        r2 = Part.makeCylinder(cls.__TunnelTopRadius,XDepth,
                               r2orig,
                               Base.Vector(1,0,0))
        opening = opening.cut(temp.cut(r2))
        panel = panel.cut(opening)
        return panel
    def MakeTunnelCut(self,board):
        bb = board.BoundBox
        X = bb.XMin
        relX = X-self.origin.x
        XDepth = bb.XLength
        owidth = self.__TunnelY2-self.__TunnelY1
        oheight = self.__TunnelZTop-self.__TunnelZ0
        openorig = self.origin.add(Base.Vector(relX,self.__TunnelY1+owidth,
                                               self.__TunnelZ0))
        opening = Part.makePlane(oheight,owidth,
                                 openorig,
                                 Base.Vector(1,0,0)).extrude(Base.Vector(XDepth,0,0))
        r1orig = openorig.add(Base.Vector(0,self.__TunnelTopRadius,
                                          oheight-self.__TunnelTopRadius))
        temp = Part.makePlane(self.__TunnelTopRadius*2,
                              self.__TunnelTopRadius*2,
                              r1orig,Base.Vector(1,0,0)).extrude(Base.Vector(XDepth))
        r1 = Part.makeCylinder(self.__TunnelTopRadius,XDepth,
                               r1orig.add(Base.Vector(0,-self.__TunnelTopRadius*2,0)),
                               Base.Vector(1,0,0))
        opening = opening.cut(temp.cut(r1))
        r2orig = openorig.add(Base.Vector(0,-owidth+self.__TunnelTopRadius,
                                          oheight-self.__TunnelTopRadius))
        temp = Part.makePlane(self.__TunnelTopRadius*2,
                              self.__TunnelTopRadius*2,
                              r2orig,Base.Vector(1,0,0)).extrude(Base.Vector(XDepth))
        r2 = Part.makeCylinder(self.__TunnelTopRadius,XDepth,
                               r2orig,
                               Base.Vector(1,0,0))
        #self.a = temp
        #self.b = r2
        opening = opening.cut(temp.cut(r2))
        return board.cut(opening)
    @classmethod
    def WireHolesPattern(cls):
        panelorig = Base.Vector(0,0,0)
        panel = PineBoard.ZYBoard(panelorig,cls.__BaseSupportHeight,
                                  cls.__Depth)
        bb = panel.BoundBox
        X = bb.XMin 
        relX = X-panelorig.x
        XDepth = bb.XLength
        for y in cls.__WireHoleYCenters:
            hole = Part.makeCylinder(cls.__WireHoleDiameter/2,XDepth,
                                     panelorig.add(Base.Vector(relX,y,
                                                                 cls.__WireHoleZCenter)),
                                     Base.Vector(1,0,0))
            panel = panel.cut(hole)
        return panel            
    def MakeWireHoles(self,board):
        bb = board.BoundBox
        X = bb.XMin
        relX = X-self.origin.x
        XDepth = bb.XLength
        for y in self.__WireHoleYCenters:
            hole = Part.makeCylinder(self.__WireHoleDiameter/2,XDepth,
                                     self.origin.add(Base.Vector(relX,y,
                                                                 self.__WireHoleZCenter)),
                                     Base.Vector(1,0,0))
            board = board.cut(hole)
        return board
    @classmethod
    def AddBoltHolesPattern(cls,panelorig,panel):
        bb = panel.BoundBox
        X = bb.XMin 
        relX = X-panelorig.x
        XDepth = bb.XLength
        for y in cls.__BoltHoleYCenters:
            for z in cls.__BoltHoleZCenters:
                hole = Part.makeCylinder(cls.__BoltHoleDiameter/2,XDepth,
                                     panelorigin.add(Base.Vector(relX,y,z)),
                                     Base.Vector(1,0,0))
                panel = panel.cut(hole)
        return panel            
    def MakeBoltHoles(self,board):
        bb = board.BoundBox
        X = bb.XMin
        relX = X-self.origin.x
        XDepth = bb.XLength
        for y in self.__BoltHoleYCenters:
            for z in self.__BoltHoleZCenters:
                hole = Part.makeCylinder(self.__BoltHoleDiameter/2,XDepth,
                                     self.origin.add(Base.Vector(relX,y,z)),
                                     Base.Vector(1,0,0))
                board = board.cut(hole)
        return board            
    def __init__(self,name,origin):
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        self.origin = origin
        self.name = name
        self.left = PineBoard.ZYBoard(
            self.origin.add(Base.Vector(self.__BaseSupportOffsets[0],0,0)),
            self.__BaseSupportHeight,
            self.__Depth)
        self.left1 = PineBoard.ZYBoard(
            self.origin.add(Base.Vector(self.__BaseSupportOffsets[1],0,0)),
            self.__BaseSupportHeight,
            self.__Depth-PineBoard.BoardThickness())
        self.right1 = PineBoard.ZYBoard(
            self.origin.add(Base.Vector(self.__BaseSupportOffsets[2],0,0)),
            self.__BaseSupportHeight,
            self.__Depth-PineBoard.BoardThickness())
        self.right = PineBoard.ZYBoard(
            self.origin.add(Base.Vector(self.__BaseSupportOffsets[3],0,0)),
            self.__BaseSupportHeight,
            self.__Depth)
        #debug("BaseUnit(): self.__BaseSupportOffsets[3] is %f",self.__BaseSupportOffsets[3])
        backlen = self.__BaseSupportOffsets[3]-self.__BaseSupportOffsets[0]
        backlen -= PineBoard.BoardThickness()
        #debug("BaseUnit(): backlen is %f",backlen)
        self.back = PineBoard.ZXBoard(
            self.origin.add(Base.Vector(PineBoard.BoardThickness()+self.__BaseSupportOffsets[0],
                                        self.__Depth-PineBoard.BoardThickness(),
                                        0)),
            self.__BaseSupportHeight,
            backlen)
        self.leftsheet = Sheet.YZSheet(self.origin,self.__Depth,self.__TotalHeight)
        self.rightsheet = Sheet.YZSheet(self.origin.add(Base.Vector(self.__Length-Sheet.ABThick(),0,0)),
                                          self.__Depth,self.__TotalHeight)
        self.backsheet = Sheet.XZSheet(self.origin.add(Base.Vector(0,self.__Depth,0)),
                                         self.__TotalHeight,self.__Length)
        self.layoutsheet = Sheet.XYSheet(self.origin.add(Base.Vector(Units.mm(3/8),
                                                                       0,
                                                                       self.__BaseSupportHeight)),
                                           self.__Length-(2*Sheet.ABThick()),
                                           self.__Depth,
                                           "Birch")
        self.bottom = Sheet.XYSheet(self.origin.add(Base.Vector(0,0,
                                                                  -Sheet.ABThick())),
                                      self.__Length,
                                      self.__Depth+Sheet.ABThick())
        self.top = Sheet.XYSheet(self.origin.add(Base.Vector(0,
                                                               Units.mm(2),
                                                               self.__TotalHeight)),
                                   self.__Length,
                                   self.__Depth-Units.mm(2)+Sheet.ABThick())
        self.leftbackdrop = Sheet.YZSheet(self.origin.add(Base.Vector(Sheet.ABThick(),
                                                                        0,
                                                                        self.__BaseSupportHeight+Sheet.BirchThick())),
                                            self.__TotalHeight-(self.__BaseSupportHeight+Sheet.BirchThick()),
                                            self.__Depth,
                                            "Masonite")
        self.rightbackdrop = Sheet.YZSheet(self.origin.add(Base.Vector(self.__Length-Sheet.ABThick()-Sheet.MasoniteThick(),
                                                                        0,
                                                                        self.__BaseSupportHeight+Sheet.BirchThick())),
                                            self.__TotalHeight-(self.__BaseSupportHeight+Sheet.BirchThick()),
                                            self.__Depth,
                                            "Masonite")
        self.backbackdrop = Sheet.XZSheet(self.origin.add(Base.Vector(Sheet.ABThick()+Sheet.MasoniteThick(),
                                                                        self.__Depth-Sheet.MasoniteThick(),
                                                                        self.__BaseSupportHeight+Sheet.BirchThick())),
                                            self.__TotalHeight-self.__BaseSupportHeight-Sheet.BirchThick(),
                                            self.__Length-(2*(Sheet.ABThick()+Sheet.MasoniteThick())),
                                            "Masonite")
        self.p1 = PineBoard.ZBeam(
                        self.origin.add(
                            Base.Vector(
                                Sheet.ABThick()+Sheet.MasoniteThick(),
                                0,
                                self.__BaseSupportHeight+Sheet.BirchThick())),
                        self.__TotalHeight-self.__BaseSupportHeight-Sheet.BirchThick())
        self.p2 = PineBoard.ZBeam(
                        self.origin.add(
                            Base.Vector(
                                Sheet.ABThick()+Sheet.MasoniteThick(),
                                self.__Depth-PineBoard.BoardThickness()-Sheet.MasoniteThick(),
                                self.__BaseSupportHeight+Sheet.BirchThick())),
                        self.__TotalHeight-self.__BaseSupportHeight-Sheet.BirchThick())
        self.p3 = PineBoard.ZBeam(
                        self.origin.add(
                            Base.Vector(
                                self.__Length-(Sheet.ABThick()+
                                               Sheet.MasoniteThick()+
                                               PineBoard.BoardThickness()),
                                0,
                                self.__BaseSupportHeight+Sheet.BirchThick())),
                        self.__TotalHeight-self.__BaseSupportHeight-Sheet.BirchThick())
        self.p4 = PineBoard.ZBeam(
                        self.origin.add(
                            Base.Vector(
                                self.__Length-(Sheet.ABThick()+
                                               Sheet.MasoniteThick()+
                                               PineBoard.BoardThickness()),
                                self.__Depth-PineBoard.BoardThickness()-Sheet.MasoniteThick(),
                                self.__BaseSupportHeight+Sheet.BirchThick())),
                        self.__TotalHeight-self.__BaseSupportHeight-Sheet.BirchThick())
        self.l1 = PineBoard.YBeam(
                    self.origin.add(
                        Base.Vector(Sheet.ABThick()+Sheet.MasoniteThick(),
                                    PineBoard.BoardThickness(),
                                    self.__TotalHeight-PineBoard.BoardThickness())),
                    self.__Depth-(2*PineBoard.BoardThickness())-Sheet.MasoniteThick())
        self.l2 = PineBoard.YBeam(
                    self.origin.add(
                        Base.Vector(self.__Length-(Sheet.ABThick()+
                                               Sheet.MasoniteThick()+
                                               PineBoard.BoardThickness()),
                                    PineBoard.BoardThickness(),
                                    self.__TotalHeight-PineBoard.BoardThickness())),
                    self.__Depth-(2*PineBoard.BoardThickness())-Sheet.MasoniteThick())
        self.l3 = PineBoard.XBeam(
                    self.origin.add(
                        Base.Vector(Sheet.ABThick()+Sheet.MasoniteThick()+
                                    PineBoard.BoardThickness(),
                                    self.__Depth-Sheet.MasoniteThick(),
                                    self.__TotalHeight-PineBoard.BoardThickness())),
                     self.__Length-(2*(Sheet.ABThick()+
                                       Sheet.MasoniteThick()+
                                       PineBoard.BoardThickness())))
        self.frontsheet = Sheet.XZSheet(
                    self.origin.add(Base.Vector(0,
                                                -Sheet.LexanThick(),
                                                -Sheet.ABThick())),
                    self.__TotalHeight-PineBoard.BoardThickness()+
                        Sheet.ABThick(),
                    self.__Length,
                    "Lexan")
        self.frontcover = Sheet.XZSheet(
                    self.origin.add(Base.Vector(0,
                                                -(Sheet.LexanThick()+
                                                  Sheet.ABThick()),
                                                -Sheet.ABThick())),
                    self.__TotalHeight+Sheet.ABThick(),
                    self.__Length)
        self.frontfillstrip = Sheet.XZSheet(
                    self.origin.add(Base.Vector(0,
                                                -Sheet.MasoniteThick(),
                                                self.__TotalHeight-
                                                    PineBoard.BoardThickness())),
                    PineBoard.BoardThickness(),
                    self.__Length,
                    "Masonite")
        self.coverblock = PineBoard.XYBoard(
                            self.origin.add(Base.Vector(
                                Sheet.ABThick()+Sheet.MasoniteThick()+
                                    PineBoard.BoardThickness(),
                                0,
                                self.__TotalHeight-PineBoard.BoardThickness())),
                            self.__Length-(2*(Sheet.ABThick()+
                                              Sheet.MasoniteThick()+
                                              PineBoard.BoardThickness())),
                            Units.mm(2))
        self.covertop = Sheet.XYSheet(
                        self.origin.add(Base.Vector(0,
                                        -(Sheet.LexanThick()+           
                                          Sheet.ABThick()),
                                        self.__TotalHeight)),
                        self.__Length,
                        Units.mm(2)+Sheet.LexanThick()+Sheet.ABThick())
        self.left1 = self.MakeWireHoles(self.left1)
        self.right1 = self.MakeWireHoles(self.right1)
    def show(self,doc=None):
        if doc==None:
            doc = App.activeDocument()
        obj = doc.addObject("Part::Feature",self.name+"_left")
        obj.Shape = self.left
        obj.Label=self.name+"_left"
        obj.ViewObject.ShapeColor=PineBoard.Color()
        obj = doc.addObject("Part::Feature",self.name+"_left1")
        obj.Shape = self.left1
