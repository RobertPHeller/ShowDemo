import FreeCAD as App
import Part, TechDraw, Mesh
from FreeCAD import Base

import os
import sys
sys.path.append(os.path.dirname(__file__))
import csv
import math
import Units
from debug import debug

def NormalizeMM(x):
    return round(x,3)

class BOMHelper(object):
    __BOM = dict()
    @classmethod
    def AddPiece(cls,width,height,kind):
        key = (NormalizeMM(width),NormalizeMM(height),kind)
        if key in cls.__BOM:
            cls.__BOM[key] += 1
        else:
            cls.__BOM[key] = 1
    @classmethod
    def _normPartSizeMM(cls,t):
        return ("%.3fx%.3f" % t)
    @staticmethod
    def _inch(mm):
        return mm / 25.4
    @classmethod
    def _normPartSizeIN(cls,t):
        X, Y = t
        return ("%.4fx%.4f" % (cls._inch(X), cls._inch(Y)))
    _units = 'in'
    @classmethod
    def SetUnits(cls,units):
        if units == 'in' or units == 'mm':
            cls._units = units
        else:
            raise RuntimeError("Unsupport units!")
    @classmethod
    def GetUnits(cls):
        return cls._units
    @classmethod
    def _normPartSize(cls,t):
        if cls._units == 'in':
            return cls._normPartSizeIN(t)
        elif cls._units == 'mm':
            return BOMHelper._normPartSizeMM(t)
        else:
            raise RuntimeError("Unsupport units!")
    @classmethod
    def ListCuts(cls,filename):
        keys = list(cls.__BOM.keys())
        keys.sort()
        f = open(filename,"w")
        w = csv.writer(f)
        w.writerow([("Size (%s)" % cls._units),"Kind","Count"])
        for key in keys:
            X, Y, kind = key
            w.writerow([cls._normPartSize((X,Y)),kind,cls.__BOM[key]])
        f.close()

class PartsHelper(object):
    __BOP = dict()
    @classmethod
    def AddPart(cls,part,count=1):
        if part in cls.__BOP:
            cls.__BOP[part] += count
        else:
            cls.__BOP[part] = count
    @classmethod
    def ListParts(cls,filename):
        parts = list(cls.__BOP.keys())
        parts.sort()
        f = open(filename,"w")
        w = csv.writer(f)
        w.writerow(["Part","Count"])
        for part in parts:
            w.writerow([ part, cls.__BOP[part] ])
        f.close()

class Elevator(object):
    __CabinWidth  = Units.HOScale(1600)
    __CabinLength = Units.HOScale(2100)
    ShaftWidth  = Units.HOScale(2200)
    ShaftLength = Units.HOScale(2800)
    __DoorWidth   = Units.HOScale(1000)
    __HeadRoom    = Units.HOScale(Units.mm(100))
    __Mechanical  = Units.HOScale(Units.mm(50))
    __ShaftColor  = tuple([0xaa/255.0,0xaa/255.0,0xaa/255.0])
    def __init__(self,name,origin,liftheight):
        self.name = name
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        self.origin = origin
        self.shaft = Part.makePlane(self.ShaftWidth,
                                    self.ShaftLength,
                                    self.origin)\
           .extrude(Base.Vector(0,0,liftheight+\
                                    (self.__HeadRoom*1.2)+\
                                    self.__Mechanical))
    def show(self,doc=None):
        if doc==None:
            doc = App.activeDocument()
        obj = doc.addObject("Part::Feature",self.name+"_shaft")
        obj.Shape = self.shaft
        obj.Label=self.name+"_shaft"
        obj.ViewObject.ShapeColor=self.__ShaftColor

class OverStation(BOMHelper, PartsHelper): 
    # Walthers Cornerstone Part # 933-3175
    # Butterfly Style Station Platform Shelter 11 x 2-1/8 x 2-1/4"
    __ShortPlatformLength = Units.mm(11)
    # 2X end to end
    __LongPlatformLength  = Units.mm(22)
    __PlatformWidth       = Units.mm(2.125)
    __PlatformRoofHeight  = Units.mm(2.25)
    # Raised platform (level boarding)
    __PlatformHeight      = Units.mm(Units.HOScale(51))
    # Walthers Cornerstone Part # 933-3175
    # Butterfly Style Station Platform Shelter 11 x 2-1/8 x 2-1/4"
    __ShortPlatformLength = Units.mm(11)
    # 2X end to end
    __LongPlatformLength  = Units.mm(22)
    __PlatformWidth       = Units.mm(2.125)
    __PlatformRoofHeight  = Units.mm(2.25)
    # Raised platform (level boarding)
    __PlatformHeight      = Units.mm(Units.HOScale(51))
    # Walthers Cornerstone Part # 933-3175
    # Butterfly Style Station Platform Shelter 11 x 2-1/8 x 2-1/4"
    __ShortPlatformLength = Units.mm(11)
    # 2X end to end
    __LongPlatformLength  = Units.mm(22)
    __PlatformWidth       = Units.mm(2.125)
    __PlatformRoofHeight  = Units.mm(2.25)
    # Raised platform (level boarding)
    __PlatformHeight      = Units.mm(Units.HOScale(51))
    # Walthers Cornerstone Part # 933-3175
    # Butterfly Style Station Platform Shelter 11 x 2-1/8 x 2-1/4"
    __ShortPlatformLength = Units.mm(11)
    # 2X end to end
    __LongPlatformLength  = Units.mm(22)
    __PlatformWidth       = Units.mm(2.125)
    __PlatformRoofHeight  = Units.mm(2.25)
    # Raised platform (level boarding)
    __PlatformHeight      = Units.mm(Units.HOScale(51))
    # Walthers Cornerstone Part # 933-3175
    # Butterfly Style Station Platform Shelter 11 x 2-1/8 x 2-1/4"
    __ShortPlatformLength = Units.mm(11)
    # 2X end to end
    __LongPlatformLength  = Units.mm(22)
    __PlatformWidth       = Units.mm(2.125)
    __PlatformRoofHeight  = Units.mm(2.25)
    # Raised platform (level boarding)
    __PlatformHeight      = Units.mm(Units.HOScale(51))
    __CombinedTrackAndPlatformWidth = Units.mm(8.1)
    __TotalStationLength = Units.mm(22.5)
    __MainWallWidth = Units.HOScale(Units.mm(6))
    __GlassWallWidth  = Units.HOScale(Units.mm(3))
    __PlastructPS_97Thick = .5
    __PlatformRoofThickness = Units.HOScale(Units.mm(6))
    __StairRiser         = Units.mm(Units.HOScale(5.5))
    __StairTread         = Units.mm(Units.HOScale(11))
    __PostOffset         = Units.mm(Units.HOScale(Units.inches(5)))
    __PostSpacing        = Units.mm(Units.HOScale(Units.inches(10)))
    __PostDiameter       = Units.mm(Units.HOScale(Units.inches(2)))
    __BridgeWidth        = Units.mm(Units.HOScale(Units.inches(24)))
    __MainStationWidth   = Units.mm(Units.HOScale(Units.inches(75)))
    __MainStationLength  = Units.mm(Units.HOScale(Units.inches(40)))
    __MainStationXOffset = -Units.mm(Units.HOScale(Units.inches(10)))
    __StationHeight      = Units.mm(Units.HOScale(Units.inches(12)))
    @property
    def __StairRiseRatio(self):
        return self.__StairTread/self.__StairRiser
    __StairLandingRiseMax = Units.mm(Units.inches(Units.HOScale( 12 )))
    __StairHeadRoomMin    = Units.mm(Units.HOScale(80))
    __PlatformStairWidth  = Units.mm(Units.inches(Units.HOScale( 7 )))
    @property
    def __PlatformStairLanding(self):
        return self.__StairHeadRoom
    @property
    def __PlatformStairTotalRise(self):
        return self.__PlatformRoofHeight-self.__PlatformHeight+self.__PlatformRoofThickness
    __ParapetWallHeight = Units.mm(Units.HOScale(18))
    __StairsColor  = tuple([0xaa/255.0,0xaa/255.0,0xaa/255.0])
    __FloorColor   = (.5,.5,.5)
    __BrickWallColor = (139.0/255.0,  26.0/255.0,  26.0/255.0)
    def __TotalStairLength(self,height,landing):
        landings = math.floor(height / self.__StairLandingRiseMax)
        return (height*self.__StairRiseRatio)+(landings*landing)
    def __makeStairs(self,origin,height,width,extraLanding=0):
        z=0
        lastLanding = 0
        length=self.__TotalStairLength(height,width)+extraLanding
        
        x = 0
        stair = None
        while z < height and x < length:
            r = self.__StairRiser
            if z+r > height:
                r = height-z
            tread = self.__StairTread
            treadLength = length-x
            step = Part.makePlane(treadLength,width,origin.add(Base.Vector(x,0,z)))\
                    .extrude(Base.Vector(0,0,r))
            if stair == None:
                stair = step
            else:
                stair = stair.fuse(step)
            z = z+r
            if z >= lastLanding+self.__StairLandingRiseMax:
                x = x+ width
                lastLanding = z
            else:
                x = x+tread
        self.AddPart("Stairs_%.4fx%.4f"%(width,height))
        return stair
    def __makeStairsRev(self,origin,height,width,extraLanding=0):
        z=0
        lastLanding = 0
        length=self.__TotalStairLength(height,width)+extraLanding
        
        x = 0
        stair = None
        while z < height and x < length:
            r = self.__StairRiser
            if z+r > height:
                r = height-z
            tread = self.__StairTread
            treadLength = length-x
            step = Part.makePlane(treadLength,width,origin.add(Base.Vector(0,0,z)))\
                    .extrude(Base.Vector(0,0,r))
            if stair == None:
                stair = step
            else:
                stair = stair.fuse(step)
            z = z+r
            if z >= lastLanding+self.__StairLandingRiseMax:
                x = x+ width
                lastLanding = z
            else:
                x = x+tread
        self.AddPart("Stairs_%.4fx%.4f"%(width,height))
        return stair
    def __init__(self,name,origin):
        self.name = name
        if not isinstance(origin,Base.Vector):
            raise RuntimeError("origin is not a Vector!")
        self.origin = origin
        platformStairLen = self.__TotalStairLength(
                                    self.__PlatformStairTotalRise,
                                    self.__PlatformStairWidth)
        #debug("*** UnderStation.__init__(): platformStairLen = %f",platformStairLen)
        self.platform1StairOrigin = origin.add(Base.Vector(
                                                    self.__TotalStationLength-\
                                                        self.__ShortPlatformLength,
                                                    self.__CombinedTrackAndPlatformWidth-\
                                                    self.__PlatformStairWidth,
                                                    self.__PlatformHeight))
        self.platform1Stair = self.__makeStairsRev(self.platform1StairOrigin,
                                       self.__PlatformStairTotalRise,
                                       self.__PlatformStairWidth)
        self.platform1StairRoofCut = Part.makePlane(
                                        self.__TotalStairLength(
                                            self.__PlatformStairTotalRise,
                                            self.__PlatformStairWidth),
                                        self.__PlatformStairWidth,
                                        self.platform1StairOrigin.add(
                                            Base.Vector(0,0,
                                                        self.__PlatformStairTotalRise-
                                                            self.__MainWallWidth))
               ).extrude(Base.Vector(0,0,self.__MainWallWidth*5))
        self.platform2StairOrigin = origin.add(Base.Vector(
                                                    self.__TotalStationLength-\
                                                        self.__ShortPlatformLength,
                                                    0,
                                                    self.__PlatformHeight))
        self.platform2Stair = self.__makeStairsRev(self.platform2StairOrigin,
                                       self.__PlatformStairTotalRise,
                                       self.__PlatformStairWidth)
        self.platform2StairRoofCut = Part.makePlane(
                                        self.__TotalStairLength(
                                            self.__PlatformStairTotalRise,
                                            self.__PlatformStairWidth),
                                        self.__PlatformStairWidth,
                                        self.platform2StairOrigin.add(
                                            Base.Vector(0,0,
                                                        self.__PlatformStairTotalRise-
                                                            self.__MainWallWidth))
               ).extrude(Base.Vector(0,0,self.__MainWallWidth*5))
        elevator1Origin = self.origin.add(Base.Vector(self.__ShortPlatformLength-(3*Elevator.ShaftLength),
                                        self.__CombinedTrackAndPlatformWidth-Elevator.ShaftLength,
                                        self.__PlatformHeight))
        self.platform1Elevator = Elevator(
            "Platform1Elevator",
            elevator1Origin,
            self.__PlatformStairTotalRise)
        self.AddPart("PlatformElevator")
        elevatorShelterOrigin = Base.Vector(elevator1Origin.x,
                                            elevator1Origin.y+Elevator.ShaftLength,
                                            origin.z+self.__PlatformHeight)
        elevatorShelter = Part.makePlane(self.__PlatformRoofHeight-self.__PlatformHeight,
                                         Elevator.ShaftLength,
                                         elevatorShelterOrigin.add(
                                            Base.Vector(
                                                Elevator.ShaftWidth+\
                                                self.__PlatformStairWidth,
                                                0,
                                                0)),
                                         Base.Vector(1,0,0))\
              .extrude(Base.Vector(-self.__GlassWallWidth,0,0))
        bb = elevatorShelter.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        e1sA = Part.makePlane(self.__PlatformRoofHeight-self.__PlatformHeight,
                           self.__PlatformStairWidth,
                           elevatorShelterOrigin.add(
                            Base.Vector(
                                Elevator.ShaftWidth,
                                -Elevator.ShaftLength,
                                0)),
                           Base.Vector(0,1,0)).extrude(Base.Vector(0,self.__GlassWallWidth))
        self.elevator1Shelter = elevatorShelter.fuse(e1sA)
        bb = e1sA.BoundBox
        self.AddPiece(bb.XLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        postSkip1 = (elevator1Origin.x,elevator1Origin.x+Elevator.ShaftWidth+self.__PlatformStairWidth)
        elevator2Origin = self.origin.add(Base.Vector(self.__ShortPlatformLength-(3*Elevator.ShaftLength),
                                        0,
                                        self.__PlatformHeight))
        self.platform2Elevator = Elevator(
            "Platform2Elevator",
            elevator2Origin,
            self.__PlatformStairTotalRise)
        self.AddPart("PlatformElevator")
        elevatorShelterOrigin = Base.Vector(elevator2Origin.x,
                                            elevator2Origin.y+Elevator.ShaftLength,
                                            origin.z+self.__PlatformHeight)
        elevatorShelter = Part.makePlane(self.__PlatformRoofHeight-self.__PlatformHeight,
                                         Elevator.ShaftLength,
                                         elevatorShelterOrigin.add(
                                            Base.Vector(
                                                Elevator.ShaftWidth+\
                                                self.__PlatformStairWidth,
                                                0,
                                                0)),
                                         Base.Vector(1,0,0))\
              .extrude(Base.Vector(-self.__GlassWallWidth,0,0))
        bb = elevatorShelter.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        e2sA = Part.makePlane(self.__PlatformRoofHeight-self.__PlatformHeight,
                           self.__PlatformStairWidth,
                           elevatorShelterOrigin.add(
                            Base.Vector(
                                Elevator.ShaftWidth,
                                0,
                                0)),
                           Base.Vector(0,1,0)).extrude(Base.Vector(0,-self.__GlassWallWidth))
        self.elevator2Shelter = elevatorShelter.fuse(e2sA)
        bb = e2sA.BoundBox
        self.AddPiece(bb.XLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        platformBaseHeight = self.__PlatformHeight-Units.mm(Units.HOScale(12))
        platformBaseExtrude = Base.Vector(0,0,platformBaseHeight)
        platformBaseWidth = self.__PlatformWidth-Units.mm(Units.HOScale(12))
        p1borigin = origin.add(Base.Vector(
                                        0,
                                        self.__CombinedTrackAndPlatformWidth-\
                                            self.__PlatformWidth+\
                                            Units.mm(Units.HOScale(12)),
                                        0))
        platform = Part.makePlane(self.__LongPlatformLength,
                                  platformBaseWidth,
                                  p1borigin)\
                 .extrude(platformBaseExtrude)
        bb = platform.BoundBox
        self.AddPiece(bb.XLength,bb.YLength,"%.3fin Wood Block"%(platformBaseHeight/25.4))
        platformTopExtrude = Base.Vector(0,0,Units.mm(Units.HOScale(12)))
        p1origin = origin.add(Base.Vector(
                                0,
                                self.__CombinedTrackAndPlatformWidth-\
                                    self.__PlatformWidth,
                                self.__PlatformHeight-\
                                    Units.mm(Units.HOScale(12))))
        platform = platform.fuse(
            Part.makePlane(self.__LongPlatformLength,
                           self.__PlatformWidth,
                           p1origin)\
                 .extrude(platformTopExtrude))
        self.platform1 = platform
        stairShelterOrigin = Base.Vector(self.platform1StairOrigin.x,
                                                    self.platform1StairOrigin.y+\
                                                        self.__PlatformStairWidth,
                                                    origin.z+self.__PlatformHeight)
        self.stairShelterOrigin1 = stairShelterOrigin
        stairShelter = Part.makePlane(
                self.__PlatformRoofHeight-self.__PlatformHeight,
                self.__TotalStairLength(self.__PlatformStairTotalRise,
                                        self.__PlatformStairWidth)+
                self.__PlatformStairWidth,
                stairShelterOrigin.add(Base.Vector(-self.__GlassWallWidth,
                                                   -self.__PlatformStairWidth,0)),
                Base.Vector(0,1,0)).extrude(Base.Vector(0,-self.__GlassWallWidth,0))
        bb = stairShelter.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        ss1A = Part.makePlane(self.__PlatformRoofHeight-self.__PlatformHeight,
                                      self.__PlatformStairWidth,
                                      stairShelterOrigin.add(
                                        Base.Vector(
                                            self.__TotalStairLength(
                                                self.__PlatformStairTotalRise,
                                                self.__PlatformStairWidth)+
                                            self.__PlatformStairWidth,0,0)),
                                      Base.Vector(1,0,0))\
               .extrude(Base.Vector(self.__GlassWallWidth,0,0))
        self.stair1Shelter = stairShelter.fuse(ss1A)
        bb = ss1A.BoundBox
        self.AddPiece(bb.XLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        stairShelterOrigin = Base.Vector(self.platform2StairOrigin.x,
                                                    self.platform2StairOrigin.y+\
                                                        self.__PlatformStairWidth,
                                                    origin.z+self.__PlatformHeight)
        self.stairShelterOrigin2 = stairShelterOrigin
        stairShelter = Part.makePlane(
                self.__PlatformRoofHeight-self.__PlatformHeight,
                self.__TotalStairLength(self.__PlatformStairTotalRise,
                                        self.__PlatformStairWidth)+
                self.__PlatformStairWidth,
                stairShelterOrigin.add(Base.Vector(-self.__GlassWallWidth,
                                                   self.__GlassWallWidth,0)),
                Base.Vector(0,1,0)).extrude(Base.Vector(0,-self.__GlassWallWidth,0))
        bb = stairShelter.BoundBox
        self.AddPiece(bb.XLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        ss1A = Part.makePlane(self.__PlatformRoofHeight-self.__PlatformHeight,
                                      self.__PlatformStairWidth,
                                      stairShelterOrigin.add(
                                        Base.Vector(
                                            self.__TotalStairLength(
                                                self.__PlatformStairTotalRise,
                                                self.__PlatformStairWidth)+
                                            self.__PlatformStairWidth,0,0)),
                                      Base.Vector(1,0,0))\
               .extrude(Base.Vector(self.__GlassWallWidth,0,0))
        self.stair2Shelter = stairShelter.fuse(ss1A)
        
        bb = ss1A.BoundBox
        self.AddPiece(bb.XLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        
        platform = Part.makePlane(self.__LongPlatformLength,
                                  platformBaseWidth,
                                  origin)\
                 .extrude(platformBaseExtrude)
        bb = platform.BoundBox
        self.AddPiece(bb.XLength,bb.YLength,"%.3fin Wood Block"%(platformBaseHeight/25.4))
        platform = platform.fuse(
            Part.makePlane(self.__LongPlatformLength,
                           self.__PlatformWidth,
                           origin.add(
                            Base.Vector(
                                0,
                                0,
                                self.__PlatformHeight-\
                                    Units.mm(Units.HOScale(12)))))\
                 .extrude(platformTopExtrude))
        self.platform2 = platform
        p1RoofOrigin = Base.Vector(p1origin.x,p1origin.y,
                                   origin.z+self.__PlatformRoofHeight)
        p1roof = Part.makePlane(self.__LongPlatformLength,
                                self.__PlatformWidth,
                                p1RoofOrigin).extrude(Base.Vector(0,0,self.__PlatformRoofThickness))
        self.platform1 = self.platform1.fuse(p1roof
                   ).cut(self.platform1Elevator.shaft
                        ).cut(self.platform1StairRoofCut)
        p2RoofOrigin = Base.Vector(origin.x,origin.y,
                                   origin.z+self.__PlatformRoofHeight)
        p2roof = Part.makePlane(self.__LongPlatformLength,
                                self.__PlatformWidth,
                                p2RoofOrigin).extrude(Base.Vector(0,0,self.__PlatformRoofThickness))
        self.platform2 = self.platform2.fuse(p2roof
                    ).cut(self.platform2Elevator.shaft
                        ).cut(self.platform2StairRoofCut)
        postEnd = p1origin.x+self.__LongPlatformLength
        postX = p1origin.x+self.__PostOffset-self.__PostSpacing
        postLength = p1RoofOrigin.z-p1origin.z-Units.mm(Units.HOScale(12))
        while postX < postEnd-self.__PostSpacing:
            postX = postX + self.__PostSpacing
            #debug("*** postX = %f, postEnd is %f",postX,postEnd)
            if postX+self.__PostDiameter/2 > postSkip1[0] and \
               postX-self.__PostDiameter/2 < postSkip1[1]:
                continue
            post1Orig = Base.Vector(postX,p1origin.y+self.__PlatformWidth/2,origin.z+self.__PlatformHeight)
            post1 = Part.makeCylinder(self.__PostDiameter/2,postLength,post1Orig)
            self.platform1 = self.platform1.fuse(post1)
            post2Orig = Base.Vector(postX,origin.y+self.__PlatformWidth/2,origin.z+self.__PlatformHeight)
            post2 = Part.makeCylinder(self.__PostDiameter/2,postLength,post2Orig)
            self.platform2 = self.platform2.fuse(post2)
        self.AddPart("Walthers Cornerstone Part # 933-3175")
        ## Station proper
        floor1 = Part.makePlane(self.__BridgeWidth,
                                self.__CombinedTrackAndPlatformWidth,
                                elevator2Origin.add(
                                    Base.Vector(Elevator.ShaftWidth,
                                                0,
                                                self.__PlatformRoofHeight+
                                                    self.__PlatformRoofThickness-
                                                    self.__PlatformHeight))
               ).extrude(Base.Vector(0,0,self.__PlatformRoofThickness))
        bb = floor1.BoundBox
        self.AddPiece(bb.XLength,bb.YLength,".080 Styreen (SSS-10824)")
        stationOrigin = elevator2Origin.add(
                            Base.Vector(self.__MainStationXOffset,
                                        self.__CombinedTrackAndPlatformWidth,
                                        self.__PlatformRoofHeight+
                                             self.__PlatformRoofThickness-
                                             self.__PlatformHeight))
        floor2 = Part.makePlane(self.__MainStationWidth,
                                self.__MainStationLength,
                                stationOrigin
               ).extrude(Base.Vector(0,0,self.__PlatformRoofThickness))
        self.floor = floor1.fuse(floor2)
        bb = floor2.BoundBox
        self.AddPiece(bb.XLength,bb.YLength,".080 Styreen (SSS-10824)")
        wallLength_y = self.__CombinedTrackAndPlatformWidth-(2*Elevator.ShaftLength)
        wallZOff = self.__PlatformRoofHeight+\
                        self.__PlatformRoofThickness-\
                        self.__PlatformHeight+\
                        self.__PlatformRoofThickness
        wall = Part.makePlane(self.__StationHeight,
                              wallLength_y,
                              elevator2Origin.add(
                                    Base.Vector(Elevator.ShaftWidth,
                                                Elevator.ShaftLength+
                                                    wallLength_y,
                                                wallZOff)),
                              Base.Vector(1,0,0)
               ).extrude(Base.Vector(self.__GlassWallWidth,0,0))
        bb = wall.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall1 = Part.makePlane(self.__StationHeight,
                               self.__CombinedTrackAndPlatformWidth,
                               elevator2Origin.add(
                                Base.Vector(Elevator.ShaftWidth+
                                                self.__BridgeWidth,
                                            self.__CombinedTrackAndPlatformWidth,
                                            wallZOff)),
                               Base.Vector(1,0,0)
                ).extrude(Base.Vector(self.__GlassWallWidth,0,0))
        bb = wall1.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall = wall.fuse(wall1)
        wall1 = Part.makePlane(self.__StationHeight,
                               self.__TotalStairLength(
                                    self.__PlatformStairTotalRise,
                                    self.__PlatformStairWidth)+5.92,
                               self.stairShelterOrigin1.add(
                                Base.Vector(0,0,wallZOff)),
                               Base.Vector(0,1,0)
                ).extrude(Base.Vector(0,self.__GlassWallWidth,0))
        bb = wall1.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall = wall.fuse(wall1)
        wall1 = Part.makePlane(self.__StationHeight+
                                    self.__PlatformRoofThickness,
                               self.__TotalStairLength(
                                    self.__PlatformStairTotalRise,
                                    self.__PlatformStairWidth),
                               self.stairShelterOrigin1.add(
                                Base.Vector(0,-self.__PlatformStairWidth,
                                            wallZOff-
                                                self.__PlatformRoofThickness)),
                               Base.Vector(0,1,0)
                ).extrude(Base.Vector(0,self.__GlassWallWidth,0))
        bb = wall1.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall = wall.fuse(wall1)
        wall1 = Part.makePlane(self.__StationHeight+
                                    self.__PlatformRoofThickness,
                               self.__PlatformStairWidth,
                               self.stairShelterOrigin1.add(
                                Base.Vector(
                                    self.__TotalStairLength(
                                        self.__PlatformStairTotalRise,
                                        self.__PlatformStairWidth),
                                    0,wallZOff-
                                        self.__PlatformRoofThickness)),
                               Base.Vector(2,0,0)
               ).extrude(Base.Vector(self.__GlassWallWidth,0,0))
        bb = wall1.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall = wall.fuse(wall1) 
        wall1 = Part.makePlane(self.__StationHeight,
                               self.__TotalStairLength(
                                    self.__PlatformStairTotalRise,
                                    self.__PlatformStairWidth),
                               self.stairShelterOrigin2.add(
                                Base.Vector(0,0,wallZOff)),
                               Base.Vector(0,1,0)
                ).extrude(Base.Vector(0,self.__GlassWallWidth,0))
        bb = wall1.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall = wall.fuse(wall1)
        wall1 = Part.makePlane(self.__StationHeight+
                                    self.__PlatformRoofThickness,
                               self.__TotalStairLength(
                                    self.__PlatformStairTotalRise,
                                    self.__PlatformStairWidth),
                               self.stairShelterOrigin2.add(
                                Base.Vector(0,-self.__PlatformStairWidth,
                                            wallZOff-
                                                self.__PlatformRoofThickness)),
                               Base.Vector(0,1,0)
                ).extrude(Base.Vector(0,self.__GlassWallWidth,0))
        bb = wall1.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall = wall.fuse(wall1)
        wall1 = Part.makePlane(self.__StationHeight+
                                    self.__PlatformRoofThickness,
                               self.__PlatformStairWidth,
                               self.stairShelterOrigin2.add(
                                Base.Vector(
                                    self.__TotalStairLength(
                                        self.__PlatformStairTotalRise,
                                        self.__PlatformStairWidth),
                                    0,wallZOff-
                                        self.__PlatformRoofThickness)),
                               Base.Vector(1,0,0)
               ).extrude(Base.Vector(self.__GlassWallWidth,0,0))
        bb = wall1.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall = wall.fuse(wall1) 
        wall1 = Part.makePlane(self.__StationHeight,
                               182.85-147.81,
                               stationOrigin.add(
                                Base.Vector(0,0,self.__PlatformRoofThickness)),
                               Base.Vector(0,1,0)
                    ).extrude(Base.Vector(0,self.__GlassWallWidth,0))
        bb = wall1.BoundBox 
        self.AddPiece(bb.XLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall = wall.fuse(wall1)
        wall1 = Part.makePlane(self.__StationHeight,
                               self.__MainStationLength-
                                self.__GlassWallWidth,
                               stationOrigin.add(
                                Base.Vector(0,self.__MainStationLength,
                                            self.__PlatformRoofThickness)),
                               Base.Vector(1,0,0)
                   ).extrude(Base.Vector(self.__GlassWallWidth,0,0))
        bb = wall1.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall = wall.fuse(wall1)
        wall1 = Part.makePlane(self.__StationHeight,
                               self.__MainStationLength-
                                self.__GlassWallWidth,
                               stationOrigin.add(
                                Base.Vector(self.__MainStationWidth-
                                                self.__GlassWallWidth,
                                            self.__MainStationLength,
                                            self.__PlatformRoofThickness)),
                               Base.Vector(1,0,0)
                   ).extrude(Base.Vector(self.__GlassWallWidth,0,0))
        bb = wall1.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall = wall.fuse(wall1)
        self.wall = wall
        backwall = Part.makePlane(self.__StationHeight+
                                    self.__PlatformRoofThickness+
                                    self.__ParapetWallHeight,
                                  self.__MainStationWidth+
                                    (2*self.__PlastructPS_97Thick),
                                  stationOrigin.add(
                                    Base.Vector(-self.__PlastructPS_97Thick,
                                                self.__MainStationLength,
                                                0)),
                                  Base.Vector(0,1,0)
                   ).extrude(Base.Vector(0,self.__PlastructPS_97Thick,0))
        bb = backwall.BoundBox
        self.AddPiece(bb.XLength,bb.ZLength,"Plastruct HO Brick (PS-97)")
        self.outerwall = backwall
        self.AddPart("Tichy Train Group #8195 Single Glass Door",6)
        self.AddPart("Tichy Train Group #8193 Strap Railing")
    def show(self,doc=None):
        if doc==None:
            doc = App.activeDocument()
        self.platform1Elevator.show(doc)
        self.platform2Elevator.show(doc)
        obj = doc.addObject("Part::Feature",self.name+"_Platform1Stairs")
        obj.Shape = self.platform1Stair
        obj.Label=self.name+"_Platform1Stairs"
        obj.ViewObject.ShapeColor=self.__StairsColor
        obj = doc.addObject("Part::Feature",self.name+"_Platform2Stairs")
        obj.Shape = self.platform2Stair
        obj.Label=self.name+"_Platform2Stairs"
        obj.ViewObject.ShapeColor=self.__StairsColor
        obj = doc.addObject("Part::Feature",self.name+"_Platform1")
        obj.Shape = self.platform1
        obj.Label=self.name+"_Platform1"
        obj.ViewObject.ShapeColor=self.__StairsColor
        obj = doc.addObject("Part::Feature",self.name+"_Platform2")
        obj.Shape = self.platform2
        obj.Label=self.name+"_Platform2"
        obj.ViewObject.ShapeColor=self.__StairsColor
        obj = doc.addObject("Part::Feature",self.name+"_Platform1StairShelter")
        obj.Shape = self.stair1Shelter
        obj.Label=self.name+"_Platform1StairShelter"
        obj.ViewObject.ShapeColor=(1.0,1.0,1.0)
        obj.ViewObject.Transparency=90
        obj = doc.addObject("Part::Feature",self.name+"_Platform2StairShelter")
        obj.Shape = self.stair2Shelter
        obj.Label=self.name+"_Platform2StairShelter"
        obj.ViewObject.ShapeColor=(1.0,1.0,1.0)
        obj.ViewObject.Transparency=90
        obj = doc.addObject("Part::Feature",self.name+"_Platform1ElevatorShelter")
        obj.Shape = self.elevator1Shelter
        obj.Label=self.name+"_Platform1ElevatorShelter"
        obj.ViewObject.ShapeColor=(1.0,1.0,1.0)
        obj.ViewObject.Transparency=90
        obj = doc.addObject("Part::Feature",self.name+"_Platform2ElevatorShelter")
        obj.Shape = self.elevator2Shelter
        obj.Label=self.name+"_Platform2ElevatorShelter"
        obj.ViewObject.ShapeColor=(1.0,1.0,1.0)
        obj.ViewObject.Transparency=90
        obj = doc.addObject("Part::Feature",self.name+"_StationFloor")
        obj.Shape = self.floor
        obj.Label=self.name+"_StationFloor"
        obj.ViewObject.ShapeColor=self.__FloorColor
        obj = doc.addObject("Part::Feature",self.name+"_StationWall")
        obj.Shape = self.wall
        obj.Label=self.name+"_StationWall"
        obj.ViewObject.ShapeColor=(1.0,1.0,1.0)
        obj.ViewObject.Transparency=90
        obj = doc.addObject("Part::Feature",self.name+"_BrickWall")
        obj.Shape = self.outerwall
        obj.Label=self.name+"_BrickWall"
        obj.ViewObject.ShapeColor=self.__BrickWallColor

if __name__ == '__main__':
    if "UnderStation" in App.listDocuments().keys():
        App.closeDocument("UnderStation")
    doc = App.newDocument("UnderStation")
    doc = App.activeDocument()
    station = OverStation("Station",Base.Vector(0,0,0))
    station.show(doc)
    Gui.activeDocument().activeView().viewFront()
    Gui.SendMsgToActiveView("ViewFit")
    OverStation.ListParts("OverStationParts.csv")
    OverStation.ListCuts("OverStationCuts.csv")    


