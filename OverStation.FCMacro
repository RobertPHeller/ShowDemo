        self.AddPart("Tichy Train Group #8198 Double Glass Door")
        self.AddPiece(bb.YLength,bb.ZLength,".040 Clear Copolyester (SSC-104)")
        wall = wall.fuse(wall1)
        self.wall = wall
        backwall = Part.makePlane(self.__StationHeight+
                                    self.__PlatformRoofThickness+
                                    self.__ParapetWallHeight,
                                  self.__MainStationWidth+
                                    (2*self.__PlastructPS_97Thick),
                                  stationOrigin.add(
                                    Base.Vector(-self.__PlastructPS_97Thick,
                                                self.__MainStationLength,
                                                0)),
                                  Base.Vector(0,1,0)
                   ).extrude(Base.Vector(0,self.__PlastructPS_97Thick,0))
        bb = backwall.BoundBox
        self.AddPiece(bb.XLength,bb.ZLength,"Plastruct HO Brick (PS-97)")
        leftwall = Part.makePlane(self.__StationHeight+
                                    self.__PlatformRoofThickness+
                                    self.__ParapetWallHeight,
                                  self.__MainStationLength+
                                    (2*self.__PlastructPS_97Thick),
                                  stationOrigin.add(
                                    Base.Vector(-self.__PlastructPS_97Thick,
                                                self.__MainStationLength+
                                                    self.__PlastructPS_97Thick,
                                                0)),
                                  Base.Vector(1,0,0)
                  ).extrude(Base.Vector(self.__PlastructPS_97Thick,0,0))
        bb = leftwall.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,"Plastruct HO Brick (PS-97)")
        vestibleOrigin = Base.Vector(bb.XMin,
                                     bb.YMin+
                                        ((bb.YLength-self.__VestibleWidth)/2),
                                     bb.ZMin)
        vestibleCutOrigin = vestibleOrigin.add(
            Base.Vector(0,self.__VestibleWidth,0))
        leftwall = leftwall.cut(
            Part.makePlane(self.__VestibleHeight+self.__PlatformRoofThickness,
                           self.__VestibleWidth,
                           vestibleCutOrigin,
                           Base.Vector(1,0,0)).extrude(
                                Base.Vector(self.__PlastructPS_97Thick,0,0)))
        vestibleFloorOrigin = vestibleOrigin.add(
            Base.Vector(-self.__VestibleLength,0,0))
        vestibleFloor = Part.makePlane(self.__VestibleLength+
                                        self.__PlastructPS_97Thick,
                                       self.__VestibleWidth,
                                       vestibleFloorOrigin).extrude(
                                        Base.Vector(0,0,
                                                    self.__PlatformRoofThickness))
        self.floor = self.floor.fuse(vestibleFloor)
        self.vestibleCeilingLeft = Part.makePlane(self.__VestibleLength+
                                        self.__PlastructPS_97Thick,
                                       self.__VestibleWidth,
                                       vestibleFloorOrigin.add(
                                        Base.Vector(0,0,
                                                    self.__PlatformRoofThickness+
                                                        self.__VestibleHeight))
                        ).extrude(Base.Vector(0,0,
                                              self.__PlatformRoofThickness))
        bb1 = self.vestibleCeilingLeft.BoundBox                                              
        self.AddPiece(bb1.XLength,bb.YLength,".080 Styreen (SSS-10824)")
        leftwall = leftwall.cut(vestibleFloor)
        windowOrigin = Base.Vector(bb.XMin,
                                   bb.YMin+self.__PlastructPS_97Thick+
                                    (self.__WindowPostWidth/2),
                                   bb.ZMin+self.__KneeWallHeight+
                                    self.__PlatformRoofThickness)
        yAdjust = Base.Vector(0,self.__WindowWidth,0)
        leftwall = leftwall.cut(
            Part.makePlane(self.__WindowHeight,
                           self.__WindowWidth,
                           windowOrigin.add(yAdjust),
                           Base.Vector(1,0,0)).extrude(
                                    Base.Vector(self.__PlastructPS_97Thick,
                                                0,0)))
        windowOrigin = windowOrigin.add(
                            Base.Vector(0,self.__WindowWidth+
                                          self.__WindowPostWidth,0))
        leftwall = leftwall.cut(
            Part.makePlane(self.__WindowHeight,
                           self.__WindowWidth,
                           windowOrigin.add(yAdjust),
                           Base.Vector(1,0,0)).extrude(
                                    Base.Vector(self.__PlastructPS_97Thick,
                                                0,0)))
        windowOrigin = windowOrigin.add(
                            Base.Vector(0,self.__VestibleWidth+
                                          self.__WindowWidth+
                                          self.__WindowPostWidth,0))
        leftwall = leftwall.cut(
            Part.makePlane(self.__WindowHeight,
                           self.__WindowWidth,
                           windowOrigin.add(yAdjust),
                           Base.Vector(1,0,0)).extrude(
                                    Base.Vector(self.__PlastructPS_97Thick,
                                                0,0)))
        windowOrigin = windowOrigin.add(
                            Base.Vector(0,self.__WindowWidth+
                                          self.__WindowPostWidth,0))
        leftwall = leftwall.cut(
            Part.makePlane(self.__WindowHeight,
                           self.__WindowWidth,
                           windowOrigin.add(yAdjust),
                           Base.Vector(1,0,0)).extrude(
                                    Base.Vector(self.__PlastructPS_97Thick,
                                                0,0)))
        vestibleInnerWall = Part.makePlane(self.__VestibleHeight,
                                           self.__VestibleLength+
                                            self.__PlastructPS_97Thick,
                                           vestibleFloorOrigin.add(
                                            Base.Vector(0,0,
                                                self.__PlatformRoofThickness)),
                                           Base.Vector(0,1,0)).extrude(
                                            Base.Vector(0,self.__MainWallWidth))
        bb = vestibleInnerWall.BoundBox
        self.AddPiece(bb.XLength,bb.ZLength,".080 Styreen (SSS-10824)")
        self.vestibleInnerWallLeft = vestibleInnerWall
        vestibleInnerWall = Part.makePlane(self.__VestibleHeight,
                                           self.__VestibleLength+
                                            self.__PlastructPS_97Thick,
                                           vestibleFloorOrigin.add(
                                            Base.Vector(0,self.__VestibleWidth-
                                                        self.__MainWallWidth,
                                                self.__PlatformRoofThickness)),
                                           Base.Vector(0,1,0)).extrude(
                                            Base.Vector(0,self.__MainWallWidth))
        bb = vestibleInnerWall.BoundBox
        self.AddPiece(bb.XLength,bb.ZLength,".080 Styreen (SSS-10824)")
        self.vestibleInnerWallLeft = self.vestibleInnerWallLeft.fuse(vestibleInnerWall)
        vestibleInnerWall = Part.makePlane(self.__VestibleHeight,
                                           self.__VestibleWidth-
                                            (2*self.__MainWallWidth),
                                           vestibleFloorOrigin.add(
                                            Base.Vector(0,self.__VestibleWidth-
                                                            self.__MainWallWidth,
                                                        self.__PlatformRoofThickness)),
                                           Base.Vector(1,0,0)).extrude(
                                            Base.Vector(self.__MainWallWidth,0,0))
        bb = vestibleInnerWall.BoundBox
        self.AddPiece(bb.YLength,bb.ZLength,".080 Styreen (SSS-10824)")
        vestibleInnerWall = vestibleInnerWall.cut(
            self.__doubleDoorCut(Base.Vector(bb.XMin,
                                             bb.YMin+.44+
                                                ((bb.YLength-self.__DoubleDoorCutWidth)/2),
                                             bb.ZMin),
                                 self.__MainWallWidth))
        self.AddPart("Tichy Train Group #8198 Double Glass Door")
        self.vestibleInnerWallLeft = self.vestibleInnerWallLeft.fuse(vestibleInnerWall)
        vestibleOuterWall = Part.makePlane(self.__VestibleHeight+
                                            self.__ParapetWallHeight+
                                            self.__PlatformRoofThickness,
                                           self.__VestibleLength+
                                            self.__PlastructPS_97Thick,
                                           vestibleFloorOrigin.add(
                                            Base.Vector(
                                                -self.__PlastructPS_97Thick,
                                                -self.__PlastructPS_97Thick,
                                                0)),
                                           Base.Vector(0,1,0)).extrude(
                                            Base.Vector(0,self.__PlastructPS_97Thick,0))
        bb = vestibleOuterWall.BoundBox
        self.AddPiece(bb.XLength,bb.ZLength,"Plastruct HO Brick (PS-97)")
        vestibleOuterWallLeft = vestibleOuterWall
        vestibleOuterWall = Part.makePlane(self.__VestibleHeight+
                                            self.__ParapetWallHeight+
                                            self.__PlatformRoofThickness,
