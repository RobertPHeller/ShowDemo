                                ).fuse(stair2Ceiling)
        bb = self.ceiling.BoundBox
        self.AddPiece(bb.XLength,bb.YLength,".080 Styreen (SSS-10824)")
        # roof
        
        self.AddPart("Tichy Train Group #8193 Strap Railing")
    def show(self,doc=None):
        if doc==None:
            doc = App.activeDocument()
        self.platform1Elevator.show(doc)
        self.platform2Elevator.show(doc)
        obj = doc.addObject("Part::Feature",self.name+"_Platform1Stairs")
        obj.Shape = self.platform1Stair
        obj.Label=self.name+"_Platform1Stairs"
        obj.ViewObject.ShapeColor=self.__StairsColor
        obj = doc.addObject("Part::Feature",self.name+"_Platform2Stairs")
        obj.Shape = self.platform2Stair
        obj.Label=self.name+"_Platform2Stairs"
        obj.ViewObject.ShapeColor=self.__StairsColor
        obj = doc.addObject("Part::Feature",self.name+"_Platform1")
        obj.Shape = self.platform1
        obj.Label=self.name+"_Platform1"
        obj.ViewObject.ShapeColor=self.__StairsColor
        obj = doc.addObject("Part::Feature",self.name+"_Platform2")
        obj.Shape = self.platform2
        obj.Label=self.name+"_Platform2"
        obj.ViewObject.ShapeColor=self.__StairsColor
        obj = doc.addObject("Part::Feature",self.name+"_Platform1StairShelter")
        obj.Shape = self.stair1Shelter
        obj.Label=self.name+"_Platform1StairShelter"
        obj.ViewObject.ShapeColor=(1.0,1.0,1.0)
        obj.ViewObject.Transparency=90
        obj = doc.addObject("Part::Feature",self.name+"_Platform2StairShelter")
        obj.Shape = self.stair2Shelter
        obj.Label=self.name+"_Platform2StairShelter"
        obj.ViewObject.ShapeColor=(1.0,1.0,1.0)
        obj.ViewObject.Transparency=90
        obj = doc.addObject("Part::Feature",self.name+"_Platform1ElevatorShelter")
        obj.Shape = self.elevator1Shelter
        obj.Label=self.name+"_Platform1ElevatorShelter"
        obj.ViewObject.ShapeColor=(1.0,1.0,1.0)
        obj.ViewObject.Transparency=90
        obj = doc.addObject("Part::Feature",self.name+"_Platform2ElevatorShelter")
        obj.Shape = self.elevator2Shelter
        obj.Label=self.name+"_Platform2ElevatorShelter"
        obj.ViewObject.ShapeColor=(1.0,1.0,1.0)
        obj.ViewObject.Transparency=90
        obj = doc.addObject("Part::Feature",self.name+"_StationFloor")
        obj.Shape = self.floor
        obj.Label=self.name+"_StationFloor"
        obj.ViewObject.ShapeColor=self.__FloorColor
        obj = doc.addObject("Part::Feature",self.name+"_StationWall")
        obj.Shape = self.wall
        obj.Label=self.name+"_StationWall"
        obj.ViewObject.ShapeColor=(1.0,1.0,1.0)
        obj.ViewObject.Transparency=90
        obj = doc.addObject("Part::Feature",self.name+"_BrickWall")
        obj.Shape = self.outerwall
        obj.Label=self.name+"_BrickWall"
        obj.ViewObject.ShapeColor=self.__BrickWallColor
        obj = doc.addObject("Part::Feature",self.name+"_LeftVestibleInnerWall")
        obj.Shape = self.vestibleInnerWallLeft
        obj.Label=self.name+"_LeftVestibleInnerWall"
        obj.ViewObject.ShapeColor=self.__InnerWallColor
        obj = doc.addObject("Part::Feature",self.name+"_RightVestibleInnerWall")
        obj.Shape = self.vestibleInnerWallRight
        obj.Label=self.name+"_RightVestibleInnerWall"
        obj.ViewObject.ShapeColor=self.__InnerWallColor
        obj = doc.addObject("Part::Feature",self.name+"_InnerWall")
        obj.Shape = self.innerwall
